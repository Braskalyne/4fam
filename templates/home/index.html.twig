{% extends 'base.html.twig' %}

{% block title %}4fam - Artistes Muralistes | Fresques & Trompe-l'œil à Paris et Lyon{% endblock %}

{% block body_class %}page-home{% endblock %}

{% block meta_description %}Collectif 4fam : artistes muralistes professionnels créant des fresques murales, trompe-l'œil et peintures artistiques uniques à Paris et Lyon. Découvrez nos réalisations.{% endblock %}

{% block meta_keywords %}artiste muraliste, fresque murale, trompe l'oeil, peinture murale, art mural, Paris, Lyon, peintre professionnel{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Fond image sur toute la page d'accueil - surcharge le fond gris du body */
        body.page-home {
            background: url('/images/PXL_20260518_140855327.PORTRAIT.jpg') center/cover fixed !important;
        }

        /* Fond mobile pour les petits écrans */
        @media (max-width: 670px) {
            body.page-home {
                background: url('/images/fond_mobile.jpg') center/cover fixed !important;
            }
        }

        /* Overlay sombre sur tout le body pour uniformiser l'assombrissement */
        body.page-home::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.6) 100%);
            z-index: 0;
            pointer-events: none;
        }

        /* Header quasi invisible sur page d'accueil */
        nav {
            background: rgba(255, 255, 255, 0.05) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1) !important;
        }
        
        nav a {
            color: rgba(255, 255, 255, 0.95) !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.7);
        }
        
        nav a:hover, nav a.active {
            color: rgba(255, 255, 255, 1) !important;
        }
        
        .hero {
            min-height: 100vh;
            background: none;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
            margin-top: 0;
            padding-top: 10px;
        }
        
        .hero::before {
            display: none;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: white;
            max-width: 900px;
            padding: 3rem;
            animation: fadeIn 1.5s ease-out;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .hero h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 6rem;
            font-weight: 700;
            margin-bottom: 2rem;
            color: white;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            text-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }
        
        .hero p {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            font-weight: 300;
            letter-spacing: 0.15em;
            color: rgba(255,255,255,0.9);
            margin-bottom: 2rem;
            text-transform: uppercase;
        }
        
        .hero-description {
            margin-bottom: 3rem;
        }
        
        .hero-description p {
            font-size: 1rem;
            font-weight: 300;
            letter-spacing: 0.05em;
            color: rgba(255,255,255,0.85);
            line-height: 1.8;
            text-transform: none;
            margin-bottom: 0;
        }
        
        .hero-buttons {
            display: flex;
            gap: 2rem;
            justify-content: center;
            flex-wrap: wrap;
        }
        
        .cta-button {
            display: inline-block;
            padding: 1.2rem 3.5rem;
            background: transparent;
            color: white;
            text-decoration: none;
            border: 2px solid rgba(255,255,255,0.6);
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: 0.9rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            border-radius: 50px;
        }
        
        .cta-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.1);
            transition: left 0.4s ease;
        }
        
        .cta-button:hover::before {
            left: 100%;
        }
        
        .cta-button:hover {
            background: rgba(255,255,255,0.95);
            color: #0a0a0a;
            border-color: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        
        .instagram-logo {
            margin-top: 1.5rem;
            display: flex;
            justify-content: center;
        }
        
        .instagram-logo svg {
            width: 48px;
            height: 48px;
            fill: white;
            filter: drop-shadow(0 4px 10px rgba(0,0,0,0.3));
            transition: all 0.3s ease;
        }
        
        .instagram-logo svg:hover {
            transform: scale(1.1);
            filter: drop-shadow(0 6px 15px rgba(0,0,0,0.4));
        }
        
        /* Footer transparent comme le header sur page d'accueil */
        body footer {
            margin-top: 0 !important;
            background: rgba(255, 255, 255, 0.05) !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
            position: relative;
            z-index: 10;
        }
        
        body footer p, body footer a {
            color: rgba(255, 255, 255, 0.95) !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.7) !important;
        }
        
        body footer a:hover {
            color: rgba(255, 255, 255, 1) !important;
        }
        
        /* Footer transparent - le z-index passe au-dessus de l'overlay */
        footer.home-footer {
            background: rgba(255, 255, 255, 0.05) !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            border-top: none !important;
            margin-top: 0 !important;
            position: relative;
            z-index: 2;
        }
        
        footer.home-footer p,
        footer.home-footer a {
            color: rgba(255, 255, 255, 0.95) !important;
            text-shadow: 0 2px 10px rgba(0,0,0,0.7) !important;
        }
        
        footer.home-footer a:hover {
            color: rgba(255, 255, 255, 1) !important;
        }
    </style>
{% endblock %}

{% block body %}
<div class="hero">
    <div class="hero-content">
        <h1>4fam</h1>
        <p>Femmes Artistes Muralistes</p>
        <div class="hero-description">
            <p>Nous sommes Maud et Camille, deux artistes passionnées spécialisées dans la création de fresques murales et de trompe-l'œil.<br>
            De Paris à Lyon, nous transformons vos espaces en œuvres d'art uniques.</p>
        </div>
        <div class="hero-buttons">
            <a href="https://www.instagram.com/collectif_4fam/" target="_blank" rel="noopener noreferrer" class="cta-button">Suivez-nous !</a>
        </div>
        <div class="instagram-logo">
            <a href="https://www.instagram.com/collectif_4fam/" target="_blank" rel="noopener noreferrer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
            </a>
        </div>
    </div>
</div>
{% endblock %}

{% block footer %}
<footer class="home-footer">
    <p>&copy; {{ "now"|date("Y") }} 4fam - Artistes Muralistes. Tous droits réservés.</p>
    <div class="footer-links">
        <a href="{{ path('app_legal') }}">Mentions Légales</a>
        <a href="{{ path('app_privacy') }}">Politique de Confidentialité</a>
    </div>
    <p style="margin-top: 1.5rem; font-size: 0.7rem; opacity: 0.8;">
        Site réalisé par <a href="https://www.augustin-gantelmi.fr" target="_blank" rel="noopener noreferrer" style="text-decoration: underline;">Augustin Gantelmi</a>
    </p>
</footer>
{% endblock %}
